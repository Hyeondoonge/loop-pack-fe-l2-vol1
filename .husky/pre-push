pnpm tsc --noEmit && echo '컴파일 성공🥳' || (echo '컴파일 실패😞' && exit 1)

# ponytail: 여러 ref를 한 번에 push하면 마지막 ref 기준으로만 검토(단순화). 필요해지면 ref별 누적으로 확장
empty_tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904
zero=0000000000000000000000000000000000000000
range=""
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "$zero" ]; then
    base="$(git merge-base main "$local_sha" 2>/dev/null || echo "$empty_tree")"
  else
    base="$remote_sha"
  fi
  range="$base..$local_sha"
done

if [ -n "$range" ]; then
  files=$(git diff --name-only --diff-filter=ACM "$range" -- src 2>/dev/null | grep -E '\.(ts|tsx)$' || true)
  if [ -n "$files" ]; then
    echo "🔍 state-architecture-review 자동 검토 중 (경고용, push는 막지 않음)"
    claude -p "state-architecture-review 스킬 기준으로 아래 파일들을 검토해줘. 대상 파일을 다시 묻지 말고 바로 Read해서 파일별 리포트를 출력해줘.

$files" --allowedTools "Read,Grep,Glob,Skill" || true
  fi
fi

