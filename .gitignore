# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 7주차 성능 측정 원본 자산 — 로컬 기록용으로만 보관한다.
# 트레이스·filmstrip·스크린샷은 용량이 커서(회당 5~23MB) 원격에 올리지 않는다.
# 판단 근거가 되는 수치는 문서 본문과 run-N.json에 옮겨 적었다.
docs/work/week-07/measurements/**/*.png
docs/work/week-07/measurements/**/*.trace.json
docs/work/week-07/measurements/**/*.devtoolslog.json
