{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "reporters": ["html", "json", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "app/api/home/getHomeData.ts",
    "app/api/products/getProductListData.ts",
    "src/_pages/product-list/api/toProductListQuery.ts",
    "src/_pages/product-list/lib/buildProductListMetadata.ts",
    "src/_pages/product-list/lib/resolvePageOverflow.ts",
    "src/_pages/product-list/model/productListFilters.ts",
    "src/shared/api/apiFetch.ts",
    "src/shared/lib/createIdSetStore.ts",
    "src/shared/lib/formatPrice.ts"
  ]
}
